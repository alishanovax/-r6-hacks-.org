---
import '../../styles/blog-pages.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getAllBlogSlugs, getBlogPost, getBlogPostsBySlugs, getRelatedBlogPosts } from '../../data/blog';
import { cheatMetaDescription, pageTitle } from '../../config/seo';
import { blogPostLayoutTitle, blogPostPageH1, getBlogPostSeo } from '../../config/pageSeo';
import {
  articleSchema,
  breadcrumbSchema,
  parseBlogDate,
} from '../../utils/schema';
import { checkoutPath, resolveCheckoutHref } from '../../config/checkout';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import BlogSidebar from '../../components/BlogSidebar.astro';
import BlogPostTopBar from '../../components/BlogPostTopBar.astro';
import { getBlogFaqs } from '../../data/faq';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import Icon from '../../components/icons/Icon.astro';
import type { BlogBlock } from '../../data/blog';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import BlogPostCta from '../../components/BlogPostCta.astro';
import { normalizeInternalPath, ROUTES } from '../../utils/path';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getBlogPost(slug!);

if (!post) {
  return Astro.redirect('/blog/');
}

const postPath = `/blog/${post.slug}/`;
const blogCrumbLabels: Record<string, string> = {
  'r6-practice-lobby': 'R6 practice guides (blog hub)',
  'r6-stream-proof': 'Stream-proof guides (blog hub)',
  'r6-radar': 'Radar hack guides (blog hub)',
};
const blogCrumbLabel = blogCrumbLabels[post.slug] ?? 'Blog';
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: blogCrumbLabel, path: '/blog/' },
  { name: post.title, path: postPath },
];

const related =
  post.slug === 'battleye-patch'
    ? getBlogPostsBySlugs(['battleye-fix', 'buy-r6-hacks', 'r6-external-loader'])
    : getRelatedBlogPosts(post.slug, 3);

function linkify(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label: string, href: string) => {
      const normalized = normalizeInternalPath(href);
      return `<a href="${normalized}">${label}</a>`;
    })
    .replace(/(https:\/\/r6hacks\.com[^\s.,;)]*)/g, (_match, url: string) => {
      const path = url.replace(/^https:\/\/r6hacks\.com/, '');
      const normalized = normalizeInternalPath(path);
      const href = normalized.startsWith('http') ? normalized : `https://r6hacks.org${normalized}`;
      return `<a href="${href}">${url}</a>`;
    });
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}
const published = parseBlogDate(post.date);
const fallbackDesc = cheatMetaDescription(post.desc);
const postSeoMeta = getBlogPostSeo(post.slug, { title: pageTitle(post.title), description: fallbackDesc });
const layoutTitle = blogPostLayoutTitle(post.slug, post.title);
const layoutDescription = postSeoMeta.description;
const articleH1 = blogPostPageH1(post.slug, post.title);
---

<BaseLayout
  title={layoutTitle}
  description={layoutDescription}
  ogType="article"
  ogImage={post.image}
  ogImageAlt={post.title}
  articlePublishedTime={published}
  articleModifiedTime={published}
  jsonLd={[
    articleSchema({
      name: post.title,
      description: layoutDescription,
      url: postPath,
      image: post.image,
      datePublished: published,
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <BlogPostTopBar post={post} class="mt-6" />

      <div class="blog-article__layout mt-4 grid gap-6 lg:grid-cols-[minmax(14rem,16.5rem)_minmax(0,1fr)] lg:items-start lg:gap-8 xl:grid-cols-[17.5rem_minmax(0,1fr)]">
        <div class="order-1 min-w-0 lg:col-start-2 lg:row-start-1">
          <header class="blog-article__header">
            <h1 class="blog-article__title">{articleH1}</h1>
            <p class="blog-article__lead">{post.desc}</p>
            {
              post.author && (
                <p class="blog-article__byline">
                  <Icon name="users" size={14} />
                  {post.author}
                </p>
              )
            }
          </header>

          <figure class="blog-article__hero">
            <ResponsiveImage
              src={post.image}
              alt={
                post.slug === 'battleye-fix'
                  ? `${post.title} — BattlEye verification troubleshooting on PC`
                  : post.slug === 'r6-stream-proof'
                    ? `${post.title} — hide wall ESP and script overlays on stream`
                    : `${post.title} — Rainbow Six Siege hack gameplay screenshot`
              }
              width={960}
              height={540}
              loading="eager"
              fetchPriority="high"
              sizes="(min-width: 768px) 720px, 100vw"
              class="w-full object-cover"
            />
          </figure>

          <Prose class="blog-article__prose prose-headings:scroll-mt-24 max-w-none text-left">
            {post.body.map((block: BlogBlock) => {
              if (block.type === 'h2') {
                const id = slugify(block.text);
                return <h2 id={id}>{block.text}</h2>;
              }
              if (block.type === 'h3') {
                const id = slugify(block.text);
                return <h3 id={id}>{block.text}</h3>;
              }
              if (block.type === 'ul') {
                return (
                  <ul>
                    {block.items.map((item) => (
                      <li set:html={linkify(item)} />
                    ))}
                  </ul>
                );
              }
              if (block.type === 'table') {
                return (
                  <div class="overflow-x-auto">
                    <table>
                      <thead>
                        <tr>
                          {block.headers.map((header) => (
                            <th>{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>
                            {row.map((cell) => (
                              <td set:html={linkify(cell)} />
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                );
              }
              if (block.type === 'cta') {
                return (
                  <BlogPostCta
                    title={block.title}
                    html={linkify(block.text)}
                    href={resolveCheckoutHref(block.href)}
                    buyLabel={
                      post.slug === 'r6-practice-lobby'
                        ? 'Checkout after Shooting Range drills (CTA)'
                        : post.slug === 'r6-stream-proof'
                          ? 'Buy stream-proof tier (inline CTA)'
                          : post.slug === 'buy-r6-hacks'
                            ? 'Complete Lite, Pro or Elite checkout'
                            : post.slug === 'battleye-patch'
                              ? 'Open checkout after patch-day verify'
                              : undefined
                    }
                  />
                );
              }
              return <p set:html={linkify(block.text)} />;
            })}
          </Prose>

          <nav class="blog-article__actions" aria-label="Continue reading">
            <Button as="a" href={checkoutPath('r6')} variant="primary" aria-label={t.ui.checkoutAria}>
              {
                post.slug === 'battleye-fix'
                  ? 'Checkout after BattlEye fix'
                  : post.slug === 'r6-stream-proof'
                    ? 'Buy stream-proof R6 tier'
                    : post.slug === 'r6-practice-lobby'
                      ? 'Checkout after Shooting Range drills'
                      : post.slug === 'r6-radar'
                        ? 'Buy Lite radar hack tier'
                        : post.slug === 'buy-r6-hacks'
                          ? 'Start buy R6 checkout flow'
                          : post.slug === 'battleye-patch'
                            ? 'Checkout once loader status is green'
                            : 'Buy R6 Hacks'
              }
              <Icon name="arrowRight" size={17} />
            </Button>
            <Button as="a" href={ROUTES.products} variant="outline">
              {
                post.slug === 'battleye-fix'
                  ? 'Open R6 product catalog'
                  : post.slug === 'r6-stream-proof'
                    ? 'Open stream-safe product hub'
                    : post.slug === 'r6-practice-lobby'
                      ? 'Compare Lite and Pro tiers'
                      : post.slug === 'r6-radar'
                        ? 'Open R6 product catalog (radar)'
                        : post.slug === 'buy-r6-hacks'
                          ? 'Browse tier pages before checkout'
                          : post.slug === 'battleye-patch'
                            ? 'Open tier pages for post-patch reload'
                            : 'View products'
              }
            </Button>
            <Button as="a" href={ROUTES.blog} variant="outline">
              {
                post.slug === 'battleye-fix'
                  ? 'Browse patch-day guides'
                  : post.slug === 'r6-stream-proof'
                    ? 'More OBS setup guides'
                    : post.slug === 'r6-practice-lobby'
                      ? 'More Shooting Range guides'
                      : post.slug === 'r6-radar'
                        ? 'More radar and ESP guides'
                        : post.slug === 'buy-r6-hacks'
                          ? 'More purchase and setup guides'
                          : post.slug === 'battleye-patch'
                            ? 'More BattlEye and loader guides'
                            : 'More articles'
              }
              <Icon name="arrowRight" size={17} />
            </Button>
          </nav>
        </div>

        <BlogSidebar post={post} related={related} class="order-2 lg:col-start-1 lg:row-start-1" />
      </div>
    </div>
  </article>

  <SiteFaqSection
    items={getBlogFaqs(post.tag, post.slug)}
    titleId={`blog-faq-${post.slug}`}
    class="border-t border-border bg-muted/20"
  />
</BaseLayout>
